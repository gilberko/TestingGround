[project]
title = Netta The Super Agent
version = 1.1
custom_resources = 

[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 1280
height = 720
high_dpi = 1
dynamic_orientation = 0
update_frequency = 60
vsync = 1

[render]
clear_color_red = 0.08
clear_color_green = 0.09
clear_color_blue = 0.14
clear_color_alpha = 1

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[physics]
type = 2D
max_collision_object_count = 16

[collection]
max_instances = 4096

[factory]
max_count = 4096

[sprite]
max_count = 4096

[gui]
max_count = 16

[android]
package = com.example.nettaagent
version_code = 2
minimum_sdk_version = 21
app_icon_36x36 = /assets/icons/icon_36.png
app_icon_48x48 = /assets/icons/icon_48.png
app_icon_72x72 = /assets/icons/icon_72.png
app_icon_96x96 = /assets/icons/icon_96.png
app_icon_144x144 = /assets/icons/icon_144.png
app_icon_192x192 = /assets/icons/icon_192.png

[netta]
autostart = 0
